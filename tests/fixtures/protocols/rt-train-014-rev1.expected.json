     "box": [
      72,
      93.3,
      224.7,
      15.3
     ],
     "text": "7. When the drill must not be started"
    },
    {
     "anchor": "p3.b3",
     "kind": "text",
     "under": "7. When the drill must not be started",
     "hash": "f6c8b573b5f25b980a4348ff",
     "box": [
      72,
      117.4,
      461.6,
      26.4
     ],
     "text": "Do not start the drill if the amber seal lamp on the manikin is lit, or if the bellows was serviced within the last 24 hours. This applies to adult and pediatric drills."
    },
    {
     "anchor": "p3.b4",
     "kind": "heading",
     "under": null,
     "hash": "8344b8777b436b0896899361",
     "box": [
      72,
      160.3,
      96.8,
      15.3
     ],
     "text": "8. When to stop"
    },
    {
     "anchor": "p3.b5",
     "kind": "text",
     "under": "8. When to stop",
     "hash": "d87f6d5883b65b3721e493cd",
     "box": [
      72,
      184.4,
      364.2,
      12.4
     ],
     "text": "Stop the drill at once if the red lamp lights or the gauge reads above 30 marks."
    },
    {
     "anchor": "p3.b6",
     "kind": "heading",
     "under": null,
     "hash": "b182fdb8c80bc183f11f08d5",
     "box": [
      72,
      213.3,
      83.8,
      15.3
     ],
     "text": "9. Who to call"
    },
    {
     "anchor": "p3.b7",
     "kind": "text",
     "under": "9. Who to call",
     "hash": "0db05b5df2803feb30cc57b6",
     "box": [
      72,
      237.4,
      450.6,
      26.4
     ],
     "text": "After stopping, call the Simulation Lead. If the Simulation Lead does not answer within 5 minutes, call the Education Supervisor."
    },
    {
     "anchor": "p3.b8",
     "kind": "heading",
     "under": null,
     "hash": "1d5ad03b1d488501d2595832",
     "box": [
      72,
      280.3,
      143.8,
      15.3
     ],
     "text": "Figure 1. Start decision"
    },
    {
     "anchor": "p3.b9",
     "kind": "text",
     "figure": true,
     "under": "Figure 1. Start decision",
     "hash": "307d9d291f0a0e9b5a2ff9d1",
     "box": [
      281,
      305,
      10.9,
      10
     ],
     "text": "No"
    },
    {
     "anchor": "p3.b10",
     "kind": "text",
     "figure": true,
     "under": "Figure 1. Start decision",
     "hash": "2edf4b58840c3959cc5b0bf0",
     "box": [
      85,
      313.2,
      90.8,
      11.2
     ],
     "text": "Is a drill order on file?"
    },
    {
     "anchor": "p3.b11",
     "kind": "text",
     "figure": true,
     "under": "Figure 1. Start decision",
     "hash": "31c181f7123fd0ed64a2a99c",
     "box": [
      329,
      313.2,
      200.1,
      11.2
     ],
     "text": "No order: do not start. Ask the Simulation Lead."
    },
    {
     "anchor": "p3.b12",
     "kind": "text",
     "figure": true,
     "under": "Figure 1. Start decision",
     "hash": "f701805235c3064b39a47c34",
     "box": [
      173,
      338.5,
      14.6,
      10
     ],
     "text": "Yes"
    },
    {
     "anchor": "p3.b13",
     "kind": "text",
     "figure": true,
     "under": "Figure 1. Start decision",
     "hash": "f701805235c3064b39a47c34",
     "box": [
      281,
      371,
      14.6,
      10
     ],
     "text": "Yes"
    },
    {
     "anchor": "p3.b14",
     "kind": "text",
     "figure": true,
     "under": "Figure 1. Start decision",
     "hash": "321536c14e6a1d256300fc5f",
     "box": [
      85,
      379.2,
      110.9,
      11.2
     ],
     "text": "Is the amber seal lamp lit?"
    },
    {
     "anchor": "p3.b15",
     "kind": "text",
     "figure": true,
     "under": "Figure 1. Start decision",
     "hash": "d1a0be807c6b9d48aa99e6c4",
     "box": [
      329,
      379.2,
      88.7,
      11.2
     ],
     "text": "Lamp lit: do not start."
    },
    {
     "anchor": "p3.b16",
     "kind": "text",
     "figure": true,
     "under": "Figure 1. Start decision",
     "hash": "307d9d291f0a0e9b5a2ff9d1",
     "box": [
      173,
      404.5,
      10.9,
      10
     ],
     "text": "No"
    },
    {
     "anchor": "p3.b17",
     "kind": "text",
     "figure": true,
     "under": "Figure 1. Start decision",
     "hash": "18e8ccec74e6519c145bb6a4",
     "box": [
      329,
      431.2,
      105.1,
      11.2
     ],
     "text": "Adult: start at 12 mk/min."
    },
    {
     "anchor": "p3.b18",
     "kind": "text",
     "figure": true,
     "under": "Figure 1. Start decision",
     "hash": "50cf29eb3113d639413de903",
     "box": [
      85,
      445.2,
      134.6,
      11.2
     ],
     "text": "Which age band is the manikin?"
    },
    {
     "anchor": "p3.b19",
     "kind": "text",
     "figure": true,
     "under": "Figure 1. Start decision",
     "hash": "be84d6e64986b5e9231c4f05",
     "box": [
      329,
      467.2,
      115.1,
      11.2
     ],
     "text": "Pediatric: start at 6 mk/min."
    },
