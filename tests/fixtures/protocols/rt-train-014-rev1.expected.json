       ],
       "text": "Age band: Adult (18 years and over) · Starting rate: 12 mk/min · Highest rate: 20 mk/min · Recheck after: 10 minutes"
      },
      {
       "anchor": "p2.b3.r2",
       "hash": "ce2b820a987998b84e70ec24",
       "cells": [
        "Pediatric (under 18 years)",
        "6 mk/min",
