{
  "name": "department-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run prepare-assets && vite --host 127.0.0.1",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "fixtures:regenerate": "python3 scripts/make-fixtures.py",
    "fixtures:protocols": "python3 scripts/make-protocol-fixtures.py && node scripts/protocol-fixture-data.mjs",
    "build": "npm run prepare-assets && vite build",
    "build:demo": "npm run prepare-assets && vite build --mode demo --outDir dist-demo",
    "test": "node --test tests/*.test.js",
    "test:shared": "node scripts/check-shared.mjs",
    "server": "node server/index.mjs",
    "seed:shared": "node server/seed.mjs",
    "gate:shared": "node scripts/shared-gate.mjs",
    "test:server": "node --test --test-concurrency=1 tests/server/*.test.mjs",
    "bootstrap:admin": "node server/bootstrap.mjs",
    "eval:ask": "node scripts/eval-ask.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0",
    "@tesseract.js-data/eng": "1.0.0",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "vite": "7.3.1"
  }
}
