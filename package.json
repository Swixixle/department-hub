{
  "name": "department-hub",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "npm run prepare-assets && vite --host 127.0.0.1",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "fixtures:regenerate": "python3 scripts/make-fixtures.py",
    "build": "npm run prepare-assets && vite build",
    "build:demo": "npm run prepare-assets && vite build --mode demo --outDir dist-demo",
    "test": "node --test tests/*.test.js",
    "test:shared": "node scripts/check-shared.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {"vite": "7.3.1"}
}
